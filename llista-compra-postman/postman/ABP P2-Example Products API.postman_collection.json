{
  "info": {
    "name": "ABP P2-Example Products API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "pm.test('Each product has expected fields', function () {",
                  "  const data = pm.response.json();",
                  "  if (Array.isArray(data)) {",
                  "    data.forEach(p => {",
                  "      pm.expect(p).to.have.property('name');",
                  "      pm.expect(p).to.have.property('quantity');",
                  "      pm.expect(p).to.have.property('unit');",
                  "      pm.expect(p).to.have.property('category');",
                  "      pm.expect(p).to.have.property('purchased');",
                  "    });",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{URL_ENDPOINT}}/products",
              "host": ["{{URL_ENDPOINT}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const jsonData = pm.response.json();",
                  "pm.test('Product contains expected fields', function () {",
                  "  pm.expect(jsonData).to.have.property('name');",
                  "  pm.expect(jsonData).to.have.property('quantity');",
                  "  pm.expect(jsonData).to.have.property('unit');",
                  "  pm.expect(jsonData).to.have.property('category');",
                  "  pm.expect(jsonData).to.have.property('purchased');",
                  "});",
                  "if (jsonData && jsonData._id) { pm.collectionVariables.set('product_id', jsonData._id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smartphone XYZ\",\n  \"quantity\": 10,\n  \"unit\": \"units\",\n  \"category\": \"Electronics\",\n  \"purchased\": false\n}"
            },
            "url": {
              "raw": "{{URL_ENDPOINT}}/products",
              "host": ["{{URL_ENDPOINT}}"],
              "path": ["products"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "product_id", "value": "" }
  ]
}
