					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Response is JSON', function () { pm.response.to.be.withBody; pm.response.to.be.json; });",
									"const data = pm.response.json();",
									"pm.test('Each user has name, email, and likes array', function () {",
									"  if (Array.isArray(data)) {",
									"    data.forEach(u => {",
									"      pm.expect(u).to.have.property('name');",
									"      pm.expect(u).to.have.property('email');",
									"      pm.expect(u).to.have.property('likes');",
									"      pm.expect(u.likes).to.be.an('array');",
									"      u.likes.forEach(l => {",
									"        pm.expect(l).to.have.property('title');",
									"        pm.expect(l).to.have.property('year');",
									"        pm.expect(l).to.have.property('genre');",
									"        pm.expect(l).to.have.property('author');",
