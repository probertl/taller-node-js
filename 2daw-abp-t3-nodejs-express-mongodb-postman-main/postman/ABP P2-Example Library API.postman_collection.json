					"name": "Get All Books",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () { ",
									"    pm.response.to.have.status(200); ",
									"});",
									"pm.test('Response is JSON', function () { ",
									"    pm.response.to.be.withBody; pm.response.to.be.json; ",
									"});",
									"pm.test('Each book has expected fields and valid author', function () {",
									"  const data = pm.response.json();",
									"  if (Array.isArray(data)) {",
									"    data.forEach(b => {",
									"      pm.expect(b).to.have.property('title');",
									"      pm.expect(b).to.have.property('year');",
									"      pm.expect(b).to.have.property('genre');",
									"      pm.expect(b).to.have.property('author');",
									"      const a = b.author;",
									"      pm.expect(a).to.be.an('object');",
									"      pm.expect(a).to.have.property('name').that.is.a('string');",
									"      pm.expect(a).to.have.property('birth_year').that.is.a('number');",
									"      pm.expect(a).to.have.property('nationality').that.is.a('string');",
									"    });",
									"  }",
									"});"
